# ==============================================================================
# ROSE AI ASSISTANT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Duplicate this file as '.env' in your project root and populate with your credentials.
# NEVER commit your actual '.env' file containing real secrets to GitHub!

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Key (REQUIRED)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio:
# https://aistudio.google.com/
GEMINI_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Application Host URL (Optional, defaults to http://localhost:3000)
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. OpenRouter API Key (Optional)
# ------------------------------------------------------------------------------
# For alternative open models (Nemotron 3 Nano Omni, Laguna S 2.1, Nex-N2.5)
# Get a free key at https://openrouter.ai/
OPENROUTER_API_KEY=""

# ------------------------------------------------------------------------------
# 4. Supabase Cloud Database & Authentication (Optional for Cloud Sync)
# ------------------------------------------------------------------------------
# Get your project URL and anon public key from Supabase:
# https://supabase.com/dashboard -> Project Settings -> API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
